@model TiendaScaffolding.Models.Categoria
@{ ViewData["Title"] = "Eliminar categoría"; }
<div class="panel form-panel">
    <h1>Eliminar categoría</h1>
    <p class="warning">¿Confirmas que deseas eliminar este registro? Si tiene datos relacionados, la eliminación será rechazada.</p>
    @if (ViewBag.ErrorEliminacion != null) { <div class="validation-summary">@ViewBag.ErrorEliminacion</div> }
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.CategoriaId</dd>
        <dt>Nombre</dt><dd>@Model.Nombre</dd>
        <dt>Descripción</dt><dd>@Model.Descripcion</dd>
        <dt>Activa</dt><dd>@(Model.Activa == true ? "Sí" : "No")</dd>
        <dt>Fecha de registro</dt><dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
    </dl>
    <div class="form-actions">
        <form asp-action="Delete" asp-route-id="@Model.CategoriaId" method="post">
            <input type="hidden" asp-for="CategoriaId" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
