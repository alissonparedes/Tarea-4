@model TiendaScaffolding.Models.Categoria
@{ ViewData["Title"] = "Editar categoría"; }
<div class="panel form-panel">
    <h1>Editar categoría</h1>
    <p class="subtle">Los cinco atributos están representados. El ID es automático y no se modifica.</p>
    <form asp-action="Edit" asp-route-id="@Model.CategoriaId" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field"><label>Identificador (ID)</label><input class="form-control" type="text" value="@Model.CategoriaId" readonly />
            <input type="hidden" asp-for="CategoriaId" /></div>
            <div class="field">
                <label asp-for="Nombre">Nombre</label>
                <input asp-for="Nombre" type="text" class="form-control" required maxlength="120" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Descripcion">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="255"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Activa">Activa</label>
                <select asp-for="Activa" class="form-control"><option value="true">Sí</option><option value="false">No</option></select>
                <span asp-validation-for="Activa" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="FechaRegistro">Fecha de registro</label>
                <input asp-for="FechaRegistro" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" required />
                <span asp-validation-for="FechaRegistro" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Guardar cambios</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
