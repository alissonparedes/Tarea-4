@model TiendaScaffolding.Models.Pedido
@{ ViewData["Title"] = "Eliminar pedido"; }
<div class="panel form-panel">
    <h1>Eliminar pedido</h1>
    <p class="warning">¿Confirmas que deseas eliminar este registro? Si tiene datos relacionados, la eliminación será rechazada.</p>
    @if (ViewBag.ErrorEliminacion != null) { <div class="validation-summary">@ViewBag.ErrorEliminacion</div> }
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.PedidoId</dd>
        <dt>Fecha</dt><dd>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt>Estado</dt><dd>@Model.Estado</dd>
        <dt>Observaciones</dt><dd>@Model.Observaciones</dd>
        <dt>Cliente</dt><dd>@Model.ClienteId — @Model.Cliente.Nombres @Model.Cliente.Apellidos</dd>
    </dl>
    <div class="form-actions">
        <form asp-action="Delete" asp-route-id="@Model.PedidoId" method="post">
            <input type="hidden" asp-for="PedidoId" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
