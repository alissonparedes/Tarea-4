@model IEnumerable<TiendaScaffolding.Models.Cliente>
@{ ViewData["Title"] = "Clientes"; }
<section class="page-heading">
    <div><h1>Clientes</h1><p>Listado completo · 5 atributos por entidad, incluido el ID.</p></div>
    <a class="btn" asp-action="Create">+ Crear cliente</a>
</section>
@if (TempData["Mensaje"] != null)
{ <div class="alert-success">@TempData["Mensaje"]</div> }
<div class="table-scroll">
    <table class="table">
        <thead><tr>
                    <th>ID</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Correo electrónico</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    <td>@item.ClienteId</td>
                    <td>@item.Nombres</td>
                    <td>@item.Apellidos</td>
                    <td>@item.Correo</td>
                    <td>@item.Telefono</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.ClienteId">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.ClienteId">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@item.ClienteId">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    { <p class="empty">Todavía no hay registros. Utiliza «Crear» para agregar el primero.</p> }
</div>
