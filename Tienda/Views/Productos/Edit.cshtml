@model TiendaScaffolding.Models.Producto
@{ ViewData["Title"] = "Editar producto"; }
<div class="panel form-panel">
    <h1>Editar producto</h1>
    <p class="subtle">Los cinco atributos están representados. El ID es automático y no se modifica.</p>
    <form asp-action="Edit" asp-route-id="@Model.ProductoId" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field"><label>Identificador (ID)</label><input class="form-control" type="text" value="@Model.ProductoId" readonly />
            <input type="hidden" asp-for="ProductoId" /></div>
            <div class="field">
                <label asp-for="Nombre">Nombre</label>
                <input asp-for="Nombre" type="text" class="form-control" required maxlength="120" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Precio">Precio (USD)</label>
                <input asp-for="Precio" type="number" step="0.01" min="0" max="99999999" class="form-control" required />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Stock">Unidades en stock</label>
                <input asp-for="Stock" type="number" min="0" step="1" class="form-control" required />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="CategoriaId">Categoría</label>
                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-control" required><option value="0">Seleccione una categoría</option></select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Guardar cambios</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
