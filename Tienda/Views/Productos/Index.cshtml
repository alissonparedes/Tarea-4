@model IEnumerable<TiendaScaffolding.Models.Producto>
@{ ViewData["Title"] = "Productos"; }
<section class="page-heading">
    <div><h1>Productos</h1><p>Listado completo · 5 atributos por entidad, incluido el ID.</p></div>
    <a class="btn" asp-action="Create">+ Crear producto</a>
</section>
@if (TempData["Mensaje"] != null)
{ <div class="alert-success">@TempData["Mensaje"]</div> }
<div class="table-scroll">
    <table class="table">
        <thead><tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Precio (USD)</th>
                    <th>Unidades en stock</th>
                    <th>Categoría</th>
                    <th>Acciones</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    <td>@item.ProductoId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@item.Stock</td>
                    <td>@item.CategoriaId — @item.Categoria.Nombre</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.ProductoId">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.ProductoId">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@item.ProductoId">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    { <p class="empty">Todavía no hay registros. Utiliza «Crear» para agregar el primero.</p> }
</div>
