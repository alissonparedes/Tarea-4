@model TiendaScaffolding.Models.Producto
@{ ViewData["Title"] = "Detalles producto"; }
<div class="panel form-panel">
    <h1>Detalles de producto</h1>
    <p class="subtle">Todos los cinco atributos de la entidad.</p>
    
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.ProductoId</dd>
        <dt>Nombre</dt><dd>@Model.Nombre</dd>
        <dt>Precio (USD)</dt><dd>@Model.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd>
        <dt>Unidades en stock</dt><dd>@Model.Stock</dd>
        <dt>Categoría</dt><dd>@Model.CategoriaId — @Model.Categoria.Nombre</dd>
    </dl>
    <div class="form-actions">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.ProductoId">Editar</a>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
