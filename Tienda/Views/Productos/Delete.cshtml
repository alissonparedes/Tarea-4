@model TiendaScaffolding.Models.Producto
@{ ViewData["Title"] = "Eliminar producto"; }
<div class="panel form-panel">
    <h1>Eliminar producto</h1>
    <p class="warning">¿Confirmas que deseas eliminar este registro? Si tiene datos relacionados, la eliminación será rechazada.</p>
    @if (ViewBag.ErrorEliminacion != null) { <div class="validation-summary">@ViewBag.ErrorEliminacion</div> }
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.ProductoId</dd>
        <dt>Nombre</dt><dd>@Model.Nombre</dd>
        <dt>Precio (USD)</dt><dd>@Model.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd>
        <dt>Unidades en stock</dt><dd>@Model.Stock</dd>
        <dt>Categoría</dt><dd>@Model.CategoriaId — @Model.Categoria.Nombre</dd>
    </dl>
    <div class="form-actions">
        <form asp-action="Delete" asp-route-id="@Model.ProductoId" method="post">
            <input type="hidden" asp-for="ProductoId" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
