@model TiendaScaffolding.Models.Cliente
@{ ViewData["Title"] = "Eliminar cliente"; }
<div class="panel form-panel">
    <h1>Eliminar cliente</h1>
    <p class="warning">¿Confirmas que deseas eliminar este registro? Si tiene datos relacionados, la eliminación será rechazada.</p>
    @if (ViewBag.ErrorEliminacion != null) { <div class="validation-summary">@ViewBag.ErrorEliminacion</div> }
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.ClienteId</dd>
        <dt>Nombres</dt><dd>@Model.Nombres</dd>
        <dt>Apellidos</dt><dd>@Model.Apellidos</dd>
        <dt>Correo electrónico</dt><dd>@Model.Correo</dd>
        <dt>Teléfono</dt><dd>@Model.Telefono</dd>
    </dl>
    <div class="form-actions">
        <form asp-action="Delete" asp-route-id="@Model.ClienteId" method="post">
            <input type="hidden" asp-for="ClienteId" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
