@model TiendaScaffolding.Models.Cliente
@{ ViewData["Title"] = "Editar cliente"; }
<div class="panel form-panel">
    <h1>Editar cliente</h1>
    <p class="subtle">Los cinco atributos están representados. El ID es automático y no se modifica.</p>
    <form asp-action="Edit" asp-route-id="@Model.ClienteId" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field"><label>Identificador (ID)</label><input class="form-control" type="text" value="@Model.ClienteId" readonly />
            <input type="hidden" asp-for="ClienteId" /></div>
            <div class="field">
                <label asp-for="Nombres">Nombres</label>
                <input asp-for="Nombres" type="text" class="form-control" required maxlength="120" />
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Apellidos">Apellidos</label>
                <input asp-for="Apellidos" type="text" class="form-control" required maxlength="120" />
                <span asp-validation-for="Apellidos" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Correo">Correo electrónico</label>
                <input asp-for="Correo" type="email" class="form-control" required maxlength="150" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Telefono">Teléfono</label>
                <input asp-for="Telefono" type="tel" class="form-control" required maxlength="20" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Guardar cambios</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
