<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Tienda Scaffolding</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <a class="brand" asp-controller="Home" asp-action="Index">TIENDA MVC</a>
        <nav>
            <a asp-controller="Clientes" asp-action="Index">Clientes</a>
            <a asp-controller="Categorias" asp-action="Index">Categorías</a>
            <a asp-controller="Productos" asp-action="Index">Productos</a>
            <a asp-controller="Pedidos" asp-action="Index">Pedidos</a>
            <a asp-controller="DetallesPedido" asp-action="Index">Detalle pedidos</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer>2026</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
