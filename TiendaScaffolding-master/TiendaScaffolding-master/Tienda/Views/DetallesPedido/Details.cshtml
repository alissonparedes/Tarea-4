@model TiendaScaffolding.Models.Detallespedido
@{ ViewData["Title"] = "Detalles detalle de pedido"; }
<div class="panel form-panel">
    <h1>Detalles de detalle de pedido</h1>
    <p class="subtle">Todos los cinco atributos de la entidad.</p>
    
    <dl class="detail-list">
        <dt>ID</dt><dd>@Model.DetallePedidoId</dd>
        <dt>Pedido</dt><dd>@Model.PedidoId</dd>
        <dt>Producto</dt><dd>@Model.ProductoId — @Model.Producto.Nombre</dd>
        <dt>Cantidad</dt><dd>@Model.Cantidad</dd>
        <dt>Precio unitario (USD)</dt><dd>@Model.PrecioUnitario.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</dd>
    </dl>
    <div class="form-actions">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.DetallePedidoId">Editar</a>
        <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
