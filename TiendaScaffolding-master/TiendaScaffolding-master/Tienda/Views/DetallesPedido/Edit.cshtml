@model TiendaScaffolding.Models.Detallespedido
@{ ViewData["Title"] = "Editar detalle de pedido"; }
<div class="panel form-panel">
    <h1>Editar detalle de pedido</h1>
    <p class="subtle">Los cinco atributos están representados. El ID es automático y no se modifica.</p>
    <form asp-action="Edit" asp-route-id="@Model.DetallePedidoId" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field"><label>Identificador (ID)</label><input class="form-control" type="text" value="@Model.DetallePedidoId" readonly />
            <input type="hidden" asp-for="DetallePedidoId" /></div>
            <div class="field">
                <label asp-for="PedidoId">Pedido</label>
                <select asp-for="PedidoId" asp-items="ViewBag.PedidoId" class="form-control" required><option value="0">Seleccione un pedido</option></select>
                <span asp-validation-for="PedidoId" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="ProductoId">Producto</label>
                <select asp-for="ProductoId" asp-items="ViewBag.ProductoId" class="form-control" required><option value="0">Seleccione un producto</option></select>
                <span asp-validation-for="ProductoId" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Cantidad">Cantidad</label>
                <input asp-for="Cantidad" type="number" min="1" step="1" class="form-control" required />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="PrecioUnitario">Precio unitario (USD)</label>
                <input asp-for="PrecioUnitario" type="number" step="0.01" min="0" max="99999999" class="form-control" required />
                <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Guardar cambios</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
