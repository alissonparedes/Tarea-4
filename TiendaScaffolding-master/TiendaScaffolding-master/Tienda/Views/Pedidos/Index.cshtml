@model IEnumerable<TiendaScaffolding.Models.Pedido>
@{ ViewData["Title"] = "Pedidos"; }
<section class="page-heading">
    <div><h1>Pedidos</h1><p>Listado completo · 5 atributos por entidad, incluido el ID.</p></div>
    <a class="btn" asp-action="Create">+ Crear pedido</a>
</section>
@if (TempData["Mensaje"] != null)
{ <div class="alert-success">@TempData["Mensaje"]</div> }
<div class="table-scroll">
    <table class="table">
        <thead><tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Observaciones</th>
                    <th>Cliente</th>
                    <th>Acciones</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    <td>@item.PedidoId</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Estado</td>
                    <td>@item.Observaciones</td>
                    <td>@item.ClienteId — @item.Cliente.Nombres @item.Cliente.Apellidos</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.PedidoId">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.PedidoId">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@item.PedidoId">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    { <p class="empty">Todavía no hay registros. Utiliza «Crear» para agregar el primero.</p> }
</div>
