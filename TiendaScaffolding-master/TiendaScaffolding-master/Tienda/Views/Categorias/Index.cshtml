@model IEnumerable<TiendaScaffolding.Models.Categoria>
@{ ViewData["Title"] = "Categorías"; }
<section class="page-heading">
    <div><h1>Categorías</h1><p>Listado completo · 5 atributos por entidad, incluido el ID.</p></div>
    <a class="btn" asp-action="Create">+ Crear categoría</a>
</section>
@if (TempData["Mensaje"] != null)
{ <div class="alert-success">@TempData["Mensaje"]</div> }
<div class="table-scroll">
    <table class="table">
        <thead><tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Activa</th>
                    <th>Fecha de registro</th>
                    <th>Acciones</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    <td>@item.CategoriaId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@(item.Activa == true ? "Sí" : "No")</td>
                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@item.CategoriaId">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.CategoriaId">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@item.CategoriaId">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    { <p class="empty">Todavía no hay registros. Utiliza «Crear» para agregar el primero.</p> }
</div>
